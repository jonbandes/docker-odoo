<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grupos -->
    <record id="group_payment_request_solicitante" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Puede crear solicitudes de pago y ver únicamente las suyas.</field>
    </record>

    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Aprobador</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('payment_request.group_payment_request_solicitante'))]"/>
        <field name="comment">Puede ver todas las solicitudes y aprobar o rechazar las que le estén asignadas.</field>
    </record>

    <record id="group_payment_request_treasury" model="res.groups">
        <field name="name">Tesorería</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('payment_request.group_payment_request_approver'))]"/>
        <field name="comment">Puede ver todas las solicitudes y registrar el pago en contabilidad.</field>
    </record>

    <!-- Regla de registro: el solicitante solo ve sus propias solicitudes -->
    <record id="rule_payment_request_own" model="ir.rule">
        <field name="name">Solicitudes propias del solicitante</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="groups" eval="[(4, ref('payment_request.group_payment_request_solicitante'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Aprobador: ve todas las solicitudes (sin restricción de registro) -->
    <record id="rule_payment_request_approver_all" model="ir.rule">
        <field name="name">Aprobador ve todas las solicitudes</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="groups" eval="[(4, ref('payment_request.group_payment_request_approver'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
