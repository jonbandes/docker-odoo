<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_approval_level_tree" model="ir.ui.view">
        <field name="name">payment.approval.level.tree</field>
        <field name="model">payment.approval.level</field>
        <field name="arch" type="xml">
            <tree string="Niveles de Aprobación" editable="bottom">
                <field name="name"/>
                <field name="amount_min"/>
                <field name="approver_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_payment_approval_level" model="ir.actions.act_window">
        <field name="name">Niveles de Aprobación</field>
        <field name="res_model">payment.approval.level</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
