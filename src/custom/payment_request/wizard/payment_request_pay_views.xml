<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_request_pay_wizard_form" model="ir.ui.view">
        <field name="name">payment.request.pay.wizard.form</field>
        <field name="model">payment.request.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar Pago">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="journal_id"/>
                    <field name="payment_date"/>
                    <field name="memo"/>
                </group>
                <footer>
                    <button name="action_pay" type="object" string="Confirmar Pago" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
