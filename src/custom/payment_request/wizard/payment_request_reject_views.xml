<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">payment.request.reject.wizard.form</field>
        <field name="model">payment.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Solicitud">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="reason" placeholder="Indique el motivo del rechazo..." required="1"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Rechazar" class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
