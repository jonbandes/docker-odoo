<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporte mensual de comisiones por vendedor -->
    <record id="action_commission_report" model="ir.actions.act_window">
        <field name="name">Reporte de Comisiones</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="domain">[('order_id.state', 'in', ['sale', 'done']), ('commission_amount', '>', 0)]</field>
        <field name="context">{'group_by': ['order_id.user_id', 'order_id.date_order:month']}</field>
        <field name="groups_id" eval="[(4, ref('sale_commission.group_sale_commission_manager'))]"/>
    </record>

    <record id="view_commission_report_tree" model="ir.ui.view">
        <field name="name">sale.order.line.commission.tree</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <tree string="Comisiones" decoration-info="commission_amount == 0">
                <field name="order_id"/>
                <field name="order_id" string="Vendedor" widget="many2one"
                       domain="[('user_id', '!=', False)]"/>
                <field name="product_id"/>
                <field name="price_subtotal" sum="Total venta"/>
                <field name="commission_rate"/>
                <field name="commission_amount" sum="Total comisión"/>
                <field name="order_id" string="Fecha" widget="date"
                       optional="show"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_commission_report"
              name="Comisiones"
              parent="sale.sale_menu_root"
              action="action_commission_report"
              sequence="30"
              groups="sale_commission.group_sale_commission_manager"/>
</odoo>
