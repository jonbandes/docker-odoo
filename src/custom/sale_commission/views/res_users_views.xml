<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_commission" model="ir.ui.view">
        <field name="name">res.users.form.commission</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Comisiones" name="commissions"
                      groups="sale_commission.group_sale_commission_manager">
                    <group>
                        <field name="commission_rate" widget="percentage"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
