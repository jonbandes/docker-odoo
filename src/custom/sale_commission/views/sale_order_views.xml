<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_line_commission" model="ir.ui.view">
        <field name="name">sale.order.line.form.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="after">
                <field name="commission_rate" optional="show"
                       groups="sale_commission.group_sale_commission_manager"/>
                <field name="commission_amount" optional="show"
                       groups="sale_commission.group_sale_commission_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
