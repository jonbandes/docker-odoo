<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cron para procesar cola de webhooks cada 5 minutos -->
    <record id="cron_process_webhooks" model="ir.cron">
        <field name="name">Tienda: Procesar cola de webhooks</field>
        <field name="model_id" ref="model_shop_webhook_queue"/>
        <field name="state">code</field>
        <field name="code">model._process_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
