<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shop_webhook_config_form" model="ir.ui.view">
        <field name="name">shop.webhook.config.form</field>
        <field name="model">shop.webhook.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="url"/>
                        <field name="active"/>
                        <field name="max_retries"/>
                        <field name="timeout_seconds"/>
                        <field name="secret" groups="base.group_system"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shop_webhook_config_tree" model="ir.ui.view">
        <field name="name">shop.webhook.config.tree</field>
        <field name="model">shop.webhook.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="url"/>
                <field name="active"/>
                <field name="max_retries"/>
            </tree>
        </field>
    </record>

    <record id="action_shop_webhook_config" model="ir.actions.act_window">
        <field name="name">Configuración Webhook</field>
        <field name="res_model">shop.webhook.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
